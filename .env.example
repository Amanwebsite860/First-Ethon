# ==========================================
# Environment Variables — Autonomous AI Persona
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.
# ==========================================

# --- OpenAI API (editorial judgment + writing) ---
OPENAI_API_KEY=

# Optional: override default models
OPENAI_MODEL_JUDGE=gpt-4o-mini
OPENAI_MODEL_WRITER=gpt-4o

# --- Vercel KV (storage) ---
# These are auto-populated by Vercel when you link a KV database
# to your project (Storage tab -> Create Database -> KV -> Connect).
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# --- Persona / Agent config (optional overrides) ---
AGENT_CYCLE_INTERVAL_MINUTES=90

# --- Misc ---
NODE_ENV=development
