# ==========================================
# Environment Variables — Autonomous AI Persona
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.
# ==========================================

# --- Gemini API (editorial judgment + writing) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# REQUIRED — no code-level fallback. gemini-2.5-flash was retired for new
# users; a previous version of this app silently kept calling it anyway
# because of a hardcoded default, which masked a real Vercel deployment
# misconfiguration for a while. Verify the model name you put here is
# actually available to your API key/project in Google AI Studio before
# deploying — the app will fail at boot if either var is missing, but it
# can't validate that the model string itself is real.
GEMINI_MODEL_JUDGE=gemini-3.5-flash-lite
GEMINI_MODEL_WRITER=gemini-3.5-flash-lite

# Optional: delay (ms) between sequential judge calls within one cron
# cycle, to avoid bursting past Gemini's free-tier RPM cap when several
# candidate topics are evaluated back-to-back. Default 4500ms ≈ ~13
# requests/minute.
GEMINI_JUDGE_DELAY_MS=4500

# Optional: how many top-ranked candidates (after scoring.js's cheap
# heuristic filter/rank) get sent to the Gemini judge per cycle. Directly
# bounds Gemini call volume — discovery.js can surface more raw candidates
# than this from its multiple sources (Hacker News + RSS feeds), but only
# the top JUDGE_TOP_N of them ever cost an LLM call.
JUDGE_TOP_N=3

# --- Cron protection ---
# Set this in Vercel's project env vars. Vercel automatically sends it as
# `Authorization: Bearer <value>` when triggering scheduled cron invocations.
CRON_SECRET=

# --- Vercel KV (storage) ---
# These are auto-populated by Vercel when you link a KV database
# to your project (Storage tab -> Create Database -> KV -> Connect).
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# --- Misc ---
NODE_ENV=development

# Optional: local dev server port (defaults to 3000 if unset)
PORT=3000
