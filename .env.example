# ==========================================
# Environment Variables — Autonomous AI Persona
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.
# ==========================================

# --- Gemini API (editorial judgment + writing) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override default models.
# NOTE: as of April 2026, Gemini 2.5 Pro is paid-only — the free tier only
# covers Flash/Flash-Lite models. Both default to Flash below so this works
# out of the box on a free key. If you enable billing, you can set
# GEMINI_MODEL_WRITER to a Pro-tier model for higher-quality prose.
GEMINI_MODEL_JUDGE=gemini-2.5-flash
GEMINI_MODEL_WRITER=gemini-2.5-flash

# Optional: delay (ms) between sequential judge calls within one cron
# cycle, to avoid bursting past Gemini's free-tier RPM cap when several
# candidate topics are evaluated back-to-back. Default 4500ms ≈ ~13
# requests/minute.
GEMINI_JUDGE_DELAY_MS=4500

# --- Cron protection ---
# Set this in Vercel's project env vars. Vercel automatically sends it as
# `Authorization: Bearer <value>` when triggering scheduled cron invocations.
CRON_SECRET=

# --- Vercel KV (storage) ---
# These are auto-populated by Vercel when you link a KV database
# to your project (Storage tab -> Create Database -> KV -> Connect).
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# --- Misc ---
NODE_ENV=development

# Optional: local dev server port (defaults to 3000 if unset)
PORT=3000
